{
  "schema": {
    "type": "object",
    "title": "Antrag auf Bewohnerparkausweis",
    "description": "Beantragung eines Bewohnerparkausweises für ein Bewohnerparkgebiet der Stadt Bonn.",
    "properties": {
      "anrede": {
        "type": "string",
        "title": "Anrede",
        "oneOf": [
          { "const": "frau", "title": "Frau" },
          { "const": "herr", "title": "Herr" },
          { "const": "divers", "title": "Divers" }
        ]
      },
      "vorname": {
        "type": "string",
        "title": "Vorname",
        "minLength": 1,
        "x-fim-id": "F60000227"
      },
      "nachname": {
        "type": "string",
        "title": "Nachname",
        "minLength": 1,
        "x-fim-id": "F60000228"
      },
      "geburtsdatum": {
        "type": "string",
        "title": "Geburtsdatum",
        "format": "date"
      },
      "email": {
        "type": "string",
        "title": "E-Mail-Adresse",
        "format": "email"
      },
      "strasse": {
        "type": "string",
        "title": "Straße",
        "minLength": 1
      },
      "hausnummer": {
        "type": "string",
        "title": "Hausnummer",
        "minLength": 1,
        "maxLength": 10
      },
      "plz": {
        "type": "string",
        "title": "Postleitzahl",
        "pattern": "^[0-9]{5}$"
      },
      "ort": {
        "type": "string",
        "title": "Ort",
        "minLength": 1
      },
      "kennzeichen": {
        "type": "string",
        "title": "Amtliches Kennzeichen",
        "pattern": "^[A-ZÄÖÜ]{1,3}-[A-ZÄÖÜ]{1,2} [0-9]{1,4}[EH]?$"
      },
      "fahrzeughalter": {
        "type": "boolean",
        "title": "Ich bin Halterin/Halter des Fahrzeugs",
        "default": true
      },
      "nutzungsberechtigung": {
        "type": "string",
        "title": "Art der Nutzungsberechtigung",
        "description": "Nur erforderlich, wenn Sie nicht selbst Halterin/Halter sind.",
        "oneOf": [
          { "const": "dienstwagen", "title": "Dienstwagen / Firmenfahrzeug" },
          {
            "const": "dauerhaft-ueberlassen",
            "title": "Dauerhaft überlassenes Fahrzeug"
          },
          { "const": "carsharing", "title": "Carsharing-Fahrzeug" }
        ]
      },
      "parkzone": {
        "type": "string",
        "title": "Bewohnerparkgebiet",
        "enum": ["Altstadt", "Nordstadt", "Südstadt", "Weststadt"]
      }
    },
    "required": [
      "vorname",
      "nachname",
      "strasse",
      "hausnummer",
      "plz",
      "ort",
      "kennzeichen",
      "parkzone"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "id": "lbl_hinweis",
        "type": "Label",
        "label": "Bitte füllen Sie alle Pflichtfelder aus. Der Ausweis gilt für ein Jahr ab Ausstellungsdatum.",
        "variant": "text"
      },
      {
        "id": "grp_person",
        "type": "GroupContainer",
        "label": "Angaben zur Person",
        "children": [
          {
            "id": "ctrl_anrede",
            "type": "Control",
            "scope": "#/properties/anrede"
          },
          {
            "id": "col_name",
            "type": "ColumnContainer",
            "widths": [1, 1],
            "columns": [
              [
                {
                  "id": "ctrl_vorname",
                  "type": "Control",
                  "scope": "#/properties/vorname"
                }
              ],
              [
                {
                  "id": "ctrl_nachname",
                  "type": "Control",
                  "scope": "#/properties/nachname"
                }
              ]
            ]
          },
          {
            "id": "ctrl_geburtsdatum",
            "type": "Control",
            "scope": "#/properties/geburtsdatum"
          },
          {
            "id": "ctrl_email",
            "type": "Control",
            "scope": "#/properties/email"
          }
        ]
      },
      {
        "id": "grp_adresse",
        "type": "GroupContainer",
        "label": "Meldeadresse im Parkgebiet",
        "children": [
          {
            "id": "col_strasse",
            "type": "ColumnContainer",
            "widths": [3, 1],
            "columns": [
              [
                {
                  "id": "ctrl_strasse",
                  "type": "Control",
                  "scope": "#/properties/strasse"
                }
              ],
              [
                {
                  "id": "ctrl_hausnummer",
                  "type": "Control",
                  "scope": "#/properties/hausnummer"
                }
              ]
            ]
          },
          {
            "id": "col_ort",
            "type": "ColumnContainer",
            "widths": [1, 2],
            "columns": [
              [
                {
                  "id": "ctrl_plz",
                  "type": "Control",
                  "scope": "#/properties/plz"
                }
              ],
              [
                {
                  "id": "ctrl_ort",
                  "type": "Control",
                  "scope": "#/properties/ort"
                }
              ]
            ]
          }
        ]
      },
      {
        "id": "grp_fahrzeug",
        "type": "GroupContainer",
        "label": "Fahrzeug",
        "children": [
          {
            "id": "ctrl_kennzeichen",
            "type": "Control",
            "scope": "#/properties/kennzeichen"
          },
          {
            "id": "ctrl_fahrzeughalter",
            "type": "Control",
            "scope": "#/properties/fahrzeughalter"
          },
          {
            "id": "ctrl_nutzungsberechtigung",
            "type": "Control",
            "scope": "#/properties/nutzungsberechtigung",
            "rule": {
              "effect": "SHOW",
              "condition": {
                "scope": "#/properties/fahrzeughalter",
                "schema": { "const": false }
              }
            }
          },
          {
            "id": "ctrl_parkzone",
            "type": "Control",
            "scope": "#/properties/parkzone"
          }
        ]
      }
    ]
  },
  "tabs": [],
  "activeTabIndex": 0,
  "tabAssignments": {},
  "lineNumbersEnabled": false,
  "sectionColors": {
    "grp_person": "blue",
    "grp_adresse": "green",
    "grp_fahrzeug": "yellow"
  },
  "manifestMeta": {
    "id": "urn:de:stadt-bonn:formular:bewohnerparkausweis",
    "version": "1.0.0",
    "publisher": "Stadt Bonn — Straßenverkehrsamt",
    "legalBasis": "§ 45 Abs. 1b StVO",
    "validFrom": "2026-08-01",
    "language": "de"
  }
}
